# Meta Model API (OpenAI-compatible). Standard models only: never a *-contributor model ID.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
LEDGERLENS_VISION_MODEL=
LEDGERLENS_TEXT_MODEL=
# fake = offline client for tests and the skeleton; meta = real API
LEDGERLENS_MODEL_BACKEND=fake
LEDGERLENS_DB=ledgerlens.db
# D-10 demo guard (also set a hard Spend Limit on Meta's Billing page)
LEDGERLENS_MAX_IMAGE_BYTES=5242880
LEDGERLENS_RATE_LIMIT=20
LEDGERLENS_RATE_WINDOW_S=600
LEDGERLENS_DAILY_USD_CAP=5.0
LEDGERLENS_DAILY_CALL_CAP=1500
# Prices per million tokens: copy from the Meta models docs for the model you use
LEDGERLENS_USD_PER_M_INPUT=1.25
LEDGERLENS_USD_PER_M_OUTPUT=4.25
# Voice notes (D-15). Public web mic is OFF unless 1: audio goes to Meta's speech model, which may retain it.
LEDGERLENS_VOICE_WEB=0
LEDGERLENS_VOICE_MODEL=muse-voice-transcribe-1.0
LEDGERLENS_MAX_AUDIO_SECONDS=60
LEDGERLENS_USD_PER_AUDIO_HOUR=0.18
